---
// / — atlas index: the shelf of domains. Each entry links to /<domain>.
import { loadAllDomains } from '../lib/data';
import { buildGraph } from '../lib/graph';
import '../styles/global.css';

const domains = loadAllDomains().map((d) => ({
  slug: d.domain,
  level: d.level,
  nodes: buildGraph(d).nodes.length,
  bodies: Object.keys(d.bodies).length,
}));
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>Skill Atlas</title>
  </head>
  <body>
    <main class="atlas">
      <h1>Skill Atlas</h1>
      <p class="sub">Skill trees for real domains. Choose one and walk its main quest.</p>
      <hr class="rule" />
      <div class="entries">
        {domains.map((d) => (
          <a class="entry" href={`${base}/${d.slug}`}>
            <span class="ename">{d.slug}</span>
            <span class="elevel">{d.level}</span>
            <span class="estat"><b>{d.nodes}</b> skills · <b>{d.bodies}</b> tomes written</span>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
