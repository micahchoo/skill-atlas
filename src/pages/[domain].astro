---
// /<domain> — one static page per domain, client-rendered at three altitudes
// (overview → cluster board → node page; issues/011). Unknown slugs are not in
// getStaticPaths, so they 404 by construction. URL contract (ticket 004, extended):
// ?cluster=<id> board · ?node=<id> reading page · ?sel=<id> board selection ·
// ?school=<id> lens — all composable, all lenient on unknown ids.
import { loadDomain, loadAllDomains } from '../lib/data';
import '../styles/global.css';

export function getStaticPaths() {
  return loadAllDomains().map((d) => ({ params: { domain: d.domain } }));
}

const { domain } = Astro.params;
const data = loadDomain(domain);
if (!data) return Astro.NotFound;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{data.domain} — Skill Atlas</title>
  </head>
  <body>
    <main id="app"></main>
    <noscript><p style="padding:32px;font-family:Georgia,serif">This page needs JavaScript to render the skill tree.</p></noscript>
    <script type="application/json" is:inline set:html={json} id="domain-data"></script>
    <script>
      import { initAtlas } from '../scripts/tree-client';
      initAtlas();
    </script>
  </body>
</html>
